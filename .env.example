# Brenvio web — build-time settings (passed as Docker build args or exported before `npm run build`).
# None of these are secrets. Do NOT add NEXT_PUBLIC_* variables with tokens or keys:
# anything NEXT_PUBLIC_* is embedded into the browser bundle.

# Canonical public URL, used for Open Graph / metadata. Rebuild after changing the domain.
SITE_URL=https://app.24rubridge.ru

# Version shown by /api/health (CI sets the short git SHA).
APP_VERSION=dev

# Preview deployments stay out of search engines unless this is exactly "true".
ALLOW_INDEXING=false

# Runtime (container): PORT=3000 and HOSTNAME=0.0.0.0 are set in the Dockerfile.
