# /opt/brenvio-web/.env — server runtime settings (chmod 600, owned by root).
# No secrets are required for the mock-only preview. Never put backend tokens here:
# this file is read by the frontend container and the proxy.

# Image tag currently deployed (managed by bin/remote.sh — do not edit by hand during a deploy).
BRENVIO_TAG=initial

# Loopback port of the Next.js container (127.0.0.1:BRENVIO_PORT -> container:3000).
BRENVIO_PORT=3100

# Public hostname served by Caddy. Change it here to move the app to another domain.
BRENVIO_DOMAIN=app.24rubridge.ru
